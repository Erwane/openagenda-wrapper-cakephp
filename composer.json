{
    "name": "erwane/openagenda-wrapper-cakephp",
    "description": "CakePHP wrapper for erwane/openagenda-api package.",
    "type": "library",
    "keywords": [
        "openagenda",
        "cakephp"
    ],
    "homepage": "https://github.com/Erwane/openagenda-wrapper-cakephp",
    "support": {
        "issues": "https://github.com/Erwane/openagenda-wrapper-cakephp/issues",
        "source": "https://github.com/Erwane/openagenda-wrapper-cakephp"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Erwane",
            "email": "erwane@phea.fr",
            "homepage": "https://erwane-breton.fr"
        }
    ],
    "require": {
        "php": "^8.1",
        "erwane/openagenda-api": "^3.1",
        "cakephp/cakephp": "^5.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpunit/phpunit": "^10.5 | ^11.5"
    },
    "autoload": {
        "psr-4": {
            "OpenAgenda\\Wrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenAgenda\\Wrapper\\Test\\": "tests/"
        }
    },
    "scripts": {
        "cscheck": "vendor/bin/phpcs -p -s src tests",
        "csfix": "vendor/bin/phpcbf src tests"
    },
    "minimum-stability": "stable",
    "config": {
        "platform-check": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
